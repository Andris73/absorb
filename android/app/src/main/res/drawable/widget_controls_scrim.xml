<?xml version="1.0" encoding="utf-8"?>
<!-- Bottom fade behind the player panel so titles, progress and controls
     stay legible over any cover. Dark at the bottom, clear at the top. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:startColor="#EE000000"
        android:centerColor="#99000000"
        android:endColor="#00000000"
        android:centerY="0.5"
        android:angle="90" />
</shape>
